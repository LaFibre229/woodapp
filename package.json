{
  "name": "wood-shop",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter wood-shop-backend dev",
    "dev:storefront": "pnpm --filter wood-shop-storefront dev",
    "build": "pnpm -r build",
    "seed": "pnpm --filter wood-shop-backend seed",
    "test": "pnpm --filter wood-shop-backend test:unit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait"
  }
}
